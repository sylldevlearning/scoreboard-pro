# Copie ce fichier en .env et remplis tes vrais IDs AdMob

# Banner Ad Unit ID (Android) — trouvable dans Google AdMob > Applications > Blocs d'annonces
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Android App ID — lu par app.config.ts dans le plugin react-native-google-mobile-ads
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX

# iOS App ID — lu par app.config.ts dans le plugin react-native-google-mobile-ads
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
